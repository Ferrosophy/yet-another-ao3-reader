    "Bing 翻譯暫時無法使用，請稍後再試": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مترجم Bing غير متاح مؤقتًا. يرجى المحاولة مرة أخرى لاحقا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bing-Übersetzer ist vorübergehend nicht verfügbar. Bitte versuchen Sie es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing Translator is temporarily unavailable. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing Translator no está disponible temporalmente. Inténtelo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Traducteur Bing est temporairement indisponible. Veuillez réessayer plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिंग ट्रांसलेटर अस्थायी रूप से अनुपलब्ध है। कृपया बाद में पुन: प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerjemah Bing untuk sementara tidak tersedia. Silakan coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing Translator è temporaneamente non disponibile. Per favore riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing Translator は一時的に利用できません。後でもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing 번역기를 일시적으로 사용할 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing Vertaler is tijdelijk niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumacz Bing jest chwilowo niedostępny. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
