    "使用 Edge 瀏覽器內建的微軟翻譯端點，無需金鑰。屬非官方介面，可能變更或限流。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم نقطة نهاية الترجمة من Microsoft المضمنة في Edge، دون الحاجة إلى مفتاح. إنه غير رسمي وقد يتغير أو يكون معدله محدودًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den in Edge integrierten Microsoft-Übersetzungsendpunkt, kein Schlüssel erforderlich. Es ist inoffiziell und kann sich ändern oder die Tarife sind begrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the Microsoft translation endpoint built into Edge, no key needed. It's unofficial and may change or be rate-limited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza el punto final de traducción de Microsoft integrado en Edge, no se necesita clave. No es oficial y puede cambiar o tener una tarifa limitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le point de terminaison de traduction Microsoft intégré à Edge, aucune clé n'est nécessaire. Ce n'est pas officiel et peut changer ou être limité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एज में निर्मित Microsoft अनुवाद समापन बिंदु का उपयोग करता है, किसी कुंजी की आवश्यकता नहीं है। यह अनौपचारिक है और इसमें बदलाव हो सकता है या दर-सीमित हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan titik akhir terjemahan Microsoft yang ada di Edge, tidak memerlukan kunci. Ini tidak resmi dan dapat berubah atau dibatasi tarifnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza l'endpoint di traduzione Microsoft integrato in Edge, non è necessaria alcuna chiave. Non è ufficiale e potrebbe cambiare o avere una tariffa limitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge に組み込まれている Microsoft 翻訳エンドポイントを使用します。キーは必要ありません。これは非公式であり、変更されたり、レートが制限されたりする可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge에 내장된 Microsoft 번역 엔드포인트를 사용하며 키가 필요하지 않습니다. 비공식적이며 변경되거나 속도가 제한될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt gebruik van het Microsoft-vertaaleindpunt dat is ingebouwd in Edge, geen sleutel nodig. Het is niet-officieel en kan veranderen of aan een tariefbeperking onderhevig zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z punktu końcowego tłumaczenia Microsoft wbudowanego w Edge, nie jest potrzebny żaden klucz. Jest to nieoficjalne i może ulec zmianie lub podlegać ograniczeniom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o endpoint de tradução da Microsoft integrado ao Edge, sem necessidade de chave. Não é oficial e pode mudar ou ter taxa limitada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует конечную точку перевода Microsoft, встроенную в Edge, ключ не требуется. Он неофициальный и может меняться или иметь ограничения по скорости."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตำแหน่งข้อมูลการแปลของ Microsoft ที่มีอยู่ใน Edge โดยไม่ต้องใช้คีย์ ไม่เป็นทางการและอาจมีการเปลี่ยนแปลงหรือจำกัดอัตรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge'de yerleşik Microsoft çeviri uç noktasını kullanır, anahtara gerek yoktur. Resmi değildir ve değişebilir veya oran sınırlı olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує кінцеву точку перекладу Microsoft, вбудовану в Edge, ключ не потрібен. Це неофіційно та може змінюватись або мати обмеження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng điểm cuối dịch thuật của Microsoft được tích hợp trong Edge, không cần khóa. Nó không chính thức và có thể thay đổi hoặc bị giới hạn tỷ lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Edge 浏览器内置的微软翻译端点，无需密钥。属非官方界面，可能变更或限流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Edge 瀏覽器內建的微軟翻譯端點，無需金鑰。屬非官方介面，可能變更或限流。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Edge 瀏覽器內建的微軟翻譯端點，無需金鑰。屬非官方介面，可能變更或限流。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Edge 瀏覽器內建的微軟翻譯端點，無需金鑰。屬非官方介面，可能變更或限流。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Edge 瀏覽器內建的微軟翻譯端點，無需金鑰。屬非官方介面，可能變更或限流。"
          }
        }
      }
    },
    "使用 Google 翻譯網頁端點，無需金鑰。屬非官方介面，大量使用時可能被暫時限流。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم نقطة نهاية الويب الخاصة بترجمة Google، ولا حاجة إلى مفتاح. إنه غير رسمي وقد يكون محدودًا في ظل الاستخدام المكثف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den Web-Endpunkt von Google Translate, kein Schlüssel erforderlich. Es ist inoffiziell und kann bei starker Nutzung geschwindigkeitsbegrenzt sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Google Translate's web endpoint, no key needed. It's unofficial and may be rate-limited under heavy use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza el punto final web de Google Translate, no se necesita clave. No es oficial y puede tener una velocidad limitada en caso de uso intensivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le point de terminaison Web de Google Translate, aucune clé n'est nécessaire. Ce n'est pas officiel et peut être limité en cas d'utilisation intensive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Translate के वेब एंडपॉइंट का उपयोग करता है, किसी कुंजी की आवश्यकता नहीं है। यह अनौपचारिक है और भारी उपयोग के तहत इसकी दर सीमित हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan titik akhir web Google Terjemahan, tidak memerlukan kunci. Ini tidak resmi dan mungkin dibatasi tarifnya dalam penggunaan berat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza l'endpoint web di Google Translate, non è necessaria alcuna chiave. Non è ufficiale e potrebbe avere una velocità limitata in caso di utilizzo intenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 翻訳の Web エンドポイントを使用し、キーは必要ありません。これは非公式であり、頻繁に使用するとレートが制限される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 번역의 웹 엔드포인트를 사용하며 키가 필요하지 않습니다. 비공식적이며 사용량이 많을 경우 속도가 제한될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt gebruik van het webeindpunt van Google Translate, geen sleutel nodig. Het is niet officieel en bij intensief gebruik kan er een tariefbeperking gelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z internetowego punktu końcowego Tłumacza Google, nie jest potrzebny żaden klucz. Jest to nieoficjalne i może podlegać ograniczeniom w przypadku intensywnego użytkowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o endpoint da web do Google Translate, sem necessidade de chave. Não é oficial e pode ter taxa limitada sob uso intenso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует конечную веб-точку Google Translate, ключ не требуется. Это неофициально и может быть ограничено по скорости при интенсивном использовании."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปลายทางเว็บของ Google Translate ไม่จำเป็นต้องใช้คีย์ ไม่เป็นทางการและอาจจำกัดอัตราหากใช้งานหนัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Çeviri'nin web uç noktasını kullanır, anahtara gerek yoktur. Resmi değildir ve yoğun kullanımda hızı sınırlı olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує веб-кінцеву точку Перекладача Google, ключ не потрібен. Це неофіційно та може бути обмежено швидкістю під час інтенсивного використання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng điểm cuối web của Google Dịch, không cần khóa. Nó không chính thức và có thể bị giới hạn tốc độ khi sử dụng nhiều."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 翻译网页端点，无需密钥。属非官方界面，大量使用时可能被暂时限流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 翻譯網頁端點，無需金鑰。屬非官方介面，大量使用時可能被暫時限流。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Google 翻譯網頁端點，無需金鑰。屬非官方介面，大量使用時可能被暫時限流。"
