    "「預設」為較淡的次要文字色；「跟隨正文」與目前閱讀配色的正文顏色相同。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم \"الافتراضي\" لون نص ثانوي أفتح؛ يستخدم \"نص المطابقة\" نفس لون النص الأساسي بألوان القراءة الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Standard“ verwendet eine hellere sekundäre Textfarbe; „Match Text“ verwendet dieselbe Farbe wie der Haupttext in den aktuellen Lesefarben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Default” uses a lighter secondary text color; “Match Text” uses the same color as the body text in the current reading colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Predeterminado\" utiliza un color de texto secundario más claro; “Coincidir texto” utiliza el mismo color que el texto del cuerpo en los colores de lectura actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Par défaut » utilise une couleur de texte secondaire plus claire ; « Match Text » utilise la même couleur que le corps du texte dans les couleurs de lecture actuelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"डिफ़ॉल्ट\" हल्के माध्यमिक पाठ रंग का उपयोग करता है; \"मैच टेक्स्ट\" वर्तमान पढ़ने के रंगों में मुख्य पाठ के समान रंग का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Default” menggunakan warna teks sekunder yang lebih terang; “Match Text” menggunakan warna yang sama dengan isi teks dalam warna bacaan saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Predefinito\" utilizza un colore del testo secondario più chiaro; \"Abbina testo\" utilizza lo stesso colore del corpo del testo nei colori di lettura correnti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」では、明るい第 2 テキストの色が使用されます。 「文字に一致」は、現在の読み上げ色で本文と同じ色を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"기본값\"은 더 밝은 보조 텍스트 색상을 사용합니다. \"텍스트 일치\"는 현재 읽기 색상에서 본문 텍스트와 동일한 색상을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Standaard” gebruikt een lichtere secundaire tekstkleur; “Match Text” gebruikt dezelfde kleur als de hoofdtekst in de huidige leeskleuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Domyślne” używa jaśniejszego koloru tekstu dodatkowego; Opcja „Dopasuj tekst” używa tego samego koloru co tekst podstawowy w bieżących kolorach odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Padrão” usa uma cor de texto secundária mais clara; “Match Text” usa a mesma cor do corpo do texto nas cores de leitura atuais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«По умолчанию» использует более светлый дополнительный цвет текста; «Сопоставить текст» использует тот же цвет, что и основной текст, в текущих цветах чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ค่าเริ่มต้น” ใช้สีข้อความรองที่สว่างกว่า “จับคู่ข้อความ” ใช้สีเดียวกับข้อความเนื้อหาในสีการอ่านปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Varsayılan” daha açık bir ikincil metin rengi kullanır; “Metni Eşleştir” mevcut okuma renklerinde gövde metniyle aynı rengi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«За замовчуванням» використовує світліший допоміжний колір тексту; «Збіг тексту» використовує той самий колір, що й основний текст у поточних кольорах читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mặc định” sử dụng màu văn bản phụ nhạt hơn; “Văn bản phù hợp” sử dụng cùng màu với văn bản nội dung trong màu đọc hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「默认」为较淡的次要文本色；「跟随正文」与目前阅读配色的正文颜色相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」為較淡的次要文字色；「跟隨正文」與目前閱讀配色的正文顏色相同。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」為較淡的次要文字色；「跟隨正文」與目前閱讀配色的正文顏色相同。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」為較淡的次要文字色；「跟隨正文」與目前閱讀配色的正文顏色相同。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「預設」為較淡的次要文字色；「跟隨正文」與目前閱讀配色的正文顏色相同。"
          }
        }
      }
    },
