          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводчик Bing временно недоступен. Пожалуйста, повторите попытку позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bing Translator ไม่สามารถใช้งานได้ชั่วคราว โปรดลองอีกครั้งในภายหลัง"
