    "連續閱讀達到設定時間後，閱讀頁會提醒你休息。中斷超過 5 分鐘會重新計算。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد القراءة المتواصلة للوقت المحدد، يذكرك القارئ بأخذ قسط من الراحة. يؤدي التوقف المؤقت لأكثر من 5 دقائق إلى إعادة ضبط المؤقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem Sie die eingestellte Zeit lang ununterbrochen gelesen haben, erinnert Sie das Lesegerät daran, eine Pause einzulegen. Eine Pause von mehr als 5 Minuten setzt den Timer zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After reading continuously for the set time, the reader reminds you to take a break. A pause of more than 5 minutes resets the timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de leer continuamente durante el tiempo establecido, el lector le recuerda que debe tomar un descanso. Una pausa de más de 5 minutos reinicia el cronómetro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir lu en continu pendant la durée définie, le lecteur vous rappelle de faire une pause. Une pause de plus de 5 minutes réinitialise le chronomètre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्धारित समय तक लगातार पढ़ने के बाद पाठक आपको ब्रेक लेने की याद दिलाता है। 5 मिनट से अधिक का ठहराव टाइमर को रीसेट कर देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah membaca terus menerus selama waktu yang ditentukan, pembaca mengingatkan Anda untuk istirahat. Jeda lebih dari 5 menit akan mengatur ulang pengatur waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver letto ininterrottamente per il tempo impostato, il lettore ti ricorda di fare una pausa. Una pausa superiore a 5 minuti ripristina il timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時間読み続けると、リーダーが休憩を取るように促します。 5 分以上停止するとタイマーがリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정된 시간 동안 계속해서 읽은 후, 잠시 쉬도록 알려줍니다. 5분 이상 일시 중지하면 타이머가 재설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadat u gedurende de ingestelde tijd continu heeft gelezen, herinnert de lezer u eraan een pauze te nemen. Een pauze van meer dan 5 minuten reset de timer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po ciągłym czytaniu przez zadany czas czytnik przypomina o konieczności zrobienia sobie przerwy. Przerwa dłuższa niż 5 minut resetuje timer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ler continuamente durante o tempo definido, o leitor lembra você de fazer uma pausa. Uma pausa de mais de 5 minutos reinicia o temporizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После непрерывного чтения в течение установленного времени ридер напоминает о необходимости сделать перерыв. Пауза более 5 минут сбрасывает таймер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากอ่านอย่างต่อเนื่องตามเวลาที่กำหนด ผู้อ่านจะเตือนให้คุณหยุดพัก การหยุดชั่วคราวนานกว่า 5 นาทีจะรีเซ็ตตัวจับเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlenen süre boyunca sürekli olarak okuduktan sonra okuyucu size ara vermenizi hatırlatır. 5 dakikadan uzun bir duraklama zamanlayıcıyı sıfırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після безперервного читання протягом встановленого часу зчитувач нагадує вам зробити перерву. Пауза більше 5 хвилин скидає таймер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đọc liên tục trong khoảng thời gian đã định, người đọc sẽ nhắc bạn nghỉ ngơi. Việc tạm dừng hơn 5 phút sẽ đặt lại bộ hẹn giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续阅读达到设置时间后，阅读页会提醒你休息。中断超过 5 分钟会重新计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續閱讀達到設定時間後，閱讀頁會提醒你休息。中斷超過 5 分鐘會重新計算。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連續閱讀達到設定時間後，閱讀頁會提醒你休息。中斷超過 5 分鐘會重新計算。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
