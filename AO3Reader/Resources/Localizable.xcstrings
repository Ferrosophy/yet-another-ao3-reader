    "下載中斷：%@，稍後自動繼續": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت مقاطعة التنزيل: %@. وسوف تستأنف تلقائيا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download unterbrochen: %@. Es wird automatisch fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download interrupted: %@. It will resume automatically."
          }
        },
        "es": {
