    "回應不像 AO3 頁面，可能不是相容的鏡像": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستجابة لا تبدو مثل AO3. قد لا تكون هذه مرآة متوافقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort sieht nicht wie AO3 aus. Dies ist möglicherweise kein kompatibler Spiegel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response doesn't look like AO3. This may not be a compatible mirror."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta no se parece a AO3. Puede que este no sea un espejo compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse ne ressemble pas à AO3. Ce n'est peut-être pas un miroir compatible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिक्रिया AO3 की तरह नहीं दिखती. यह एक संगत दर्पण नहीं हो सकता है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Responsnya tidak seperti AO3. Ini mungkin bukan cermin yang kompatibel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta non sembra AO3. Questo potrebbe non essere uno specchio compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答は AO3 とは異なります。これは互換性のあるミラーではない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답은 AO3처럼 보이지 않습니다. 호환되는 미러가 아닐 수도 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord lijkt niet op AO3. Dit is mogelijk geen compatibele spiegel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź nie wygląda jak AO3. To może nie być kompatybilne lustro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta não se parece com AO3. Este pode não ser um espelho compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ не похож на AO3. Возможно, это несовместимое зеркало."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบสนองดูไม่เหมือน AO3 นี่อาจไม่ใช่กระจกที่เข้ากันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt AO3'e benzemiyor. Bu uyumlu bir ayna olmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь не схожа на AO3. Це може бути несумісне дзеркало."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản hồi không giống AO3. Đây có thể không phải là một tấm gương tương thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回应不像 AO3 页面，可能不是兼容的镜像"
          }
        },
        "zh-Hant": {
