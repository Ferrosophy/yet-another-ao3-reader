    "在閱讀頁右上角的選單中可訂閱作品、系列或作者。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك في الأعمال أو المسلسلات أو المؤلفين من القائمة الموجودة أعلى يمين القارئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnieren Sie Werke, Serien oder Autoren über das Menü oben rechts im Reader."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to works, series or authors from the menu at the top right of the reader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete a obras, series o autores desde el menú en la parte superior derecha del lector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous aux ouvrages, séries ou auteurs depuis le menu en haut à droite du lecteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठक के शीर्ष दाईं ओर स्थित मेनू से कार्यों, श्रृंखलाओं या लेखकों की सदस्यता लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlangganan karya, seri, atau penulis dari menu di kanan atas pembaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iscriviti a opere, serie o autori dal menu in alto a destra del lettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リーダーの右上にあるメニューから作品、シリーズ、または著者を購読します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리더 오른쪽 상단 메뉴에서 작품, 시리즈, 작가를 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer je op werken, series of auteurs via het menu rechtsboven in de reader."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrybuj prace, serie lub autorów z menu w prawym górnym rogu czytnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine obras, séries ou autores no menu no canto superior direito do leitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпишитесь на произведения, серии или авторов из меню справа вверху читалки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to works, series or authors from the menu at the top right of the reader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okuyucunun sağ üst kısmındaki menüden eser, dizi veya yazarlara abone olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишіться на твори, серіали чи авторів у меню у верхній правій частині читанки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký các tác phẩm, bộ truyện hoặc tác giả từ menu ở phía trên bên phải của người đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在阅读页右上角的菜单中可订阅作品、系列或作者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
