    "你已連續閱讀 %lld 分鐘，讓眼睛休息一下。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد كنت تقرأ لمدة %lld دقيقة. أعط عينيك راحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie lesen seit %lld Minuten. Gönnen Sie Ihren Augen eine Pause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have been reading for %lld minutes. Give your eyes a rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has estado leyendo durante %lld minutos. Dale un descanso a tus ojos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lisez depuis %lld minutes. Donnez du repos à vos yeux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %lld मिनट से पढ़ रहे हैं। अपनी आंखों को आराम दें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah membaca selama %lld menit. Istirahatkan mata Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai leggendo da %lld minuti. Dai una pausa ai tuoi occhi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分間読んでいます。目を休めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld분 동안 책을 읽고 계십니다. 눈을 쉬게 해주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %lld minuten gelezen. Geef je ogen rust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytasz od %lld minut. Daj odpocząć oczom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está lendo há %lld minutos. Dê um descanso aos seus olhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы читаете уже %lld минут. Дайте глазам отдохнуть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้อ่านมาเป็นเวลา %lld นาที ให้ดวงตาของคุณได้พักผ่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dakikadır okuyorsunuz. Gözlerini dinlendir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви читали %lld хвилин. Дайте очам відпочити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đọc được %lld phút. Hãy cho đôi mắt của bạn được nghỉ ngơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已连续阅读 %lld 分钟，让眼睛休息一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
