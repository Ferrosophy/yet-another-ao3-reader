    "翻譯失敗，可在控制列重新翻譯本章": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت الترجمة. استخدم عناصر التحكم لإعادة ترجمة هذا الفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung ist fehlgeschlagen. Verwenden Sie die Steuerelemente, um dieses Kapitel neu zu übersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation failed. Use the controls to retranslate this chapter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción falló. Utilice los controles para volver a traducir este capítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction a échoué. Utilisez les commandes pour retraduire ce chapitre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुवाद विफल. इस अध्याय का पुनः अनुवाद करने के लिए नियंत्रणों का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan gagal. Gunakan kontrol untuk menerjemahkan ulang bab ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzione fallita. Utilizza i controlli per ritradurre questo capitolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳に失敗しました。コントロールを使用してこの章を再翻訳します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역에 실패했습니다. 이 장을 다시 번역하려면 컨트롤을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaling mislukt. Gebruik de bedieningselementen om dit hoofdstuk opnieuw te vertalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie nie powiodło się. Użyj elementów sterujących, aby ponownie przetłumaczyć ten rozdział."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução falhou. Use os controles para traduzir novamente este capítulo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод не удался. Используйте элементы управления, чтобы перевести эту главу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลล้มเหลว ใช้ตัวควบคุมเพื่อแปลบทนี้ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri başarısız oldu. Bu bölümü yeniden çevirmek için kontrolleri kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка перекладу. Використовуйте елементи керування, щоб повторно перекласти цю главу."
