          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto” używa tego samego koloru co tekst główny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” usa a mesma cor do corpo do texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» использует тот же цвет, что и основной текст."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“อัตโนมัติ” ใช้สีเดียวกับข้อความเนื้อหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatik” gövde metniyle aynı rengi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» використовує той самий колір, що й основний текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tự động” sử dụng cùng màu với văn bản nội dung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」与正文颜色相同。"
          }
        },
        "zh-Hant": {
