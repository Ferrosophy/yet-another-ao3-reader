    "找到標籤後可查看該標籤下的所有作品，並再加入其他條件篩選": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح علامة لرؤية جميع أعمالها، ثم قم بتضييق نطاقها باستخدام المزيد من المرشحات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie einen Tag, um alle seine Werke zu sehen, und grenzen Sie sie dann mit weiteren Filtern ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a tag to see all of its works, then narrow them down with more filters"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra una etiqueta para ver todos sus trabajos y luego limítelos con más filtros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une balise pour voir toutes ses œuvres, puis affinez-les avec plus de filtres"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी टैग के सभी कार्यों को देखने के लिए उसे खोलें, फिर अधिक फ़िल्टर के साथ उन्हें सीमित करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tag untuk melihat semua karyanya, lalu persempit dengan lebih banyak filter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un tag per vedere tutti i suoi lavori, quindi restringili con più filtri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを開いてすべての作品を表示し、さらにフィルターを使用して絞り込みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그를 열어 모든 작품을 확인한 다음 더 많은 필터로 범위를 좁혀 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een tag om alle werken te zien en beperk ze vervolgens met meer filters"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz tag, aby zobaczyć wszystkie jego prace, a następnie zawęź je za pomocą większej liczby filtrów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma tag para ver todos os seus trabalhos e, em seguida, restrinja-os com mais filtros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте тег, чтобы увидеть все его работы, а затем сузьте их с помощью дополнительных фильтров."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแท็กเพื่อดูผลงานทั้งหมด จากนั้นจำกัดให้แคบลงด้วยตัวกรองเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm çalışmalarını görmek için bir etiket açın, ardından daha fazla filtreyle bunları daraltın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте тег, щоб побачити всі його роботи, а потім звузіть їх за допомогою додаткових фільтрів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thẻ để xem tất cả tác phẩm của nó, sau đó thu hẹp chúng bằng nhiều bộ lọc hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到标签后可查看该标签下的所有作品，并再加入其他条件筛选"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到標籤後可查看該標籤下的所有作品，並再加入其他條件篩選"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找到標籤後可查看該標籤下的所有作品，並再加入其他條件篩選"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "找到標籤後可查看該標籤下的所有作品，並再加入其他條件篩選"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "找到標籤後可查看該標籤下的所有作品，並再加入其他條件篩選"
          }
        }
      }
