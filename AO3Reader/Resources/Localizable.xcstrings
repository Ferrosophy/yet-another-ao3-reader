    "需要先切換到「AO3 帳號」並登入，才能匯入。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالتبديل إلى \"حساب AO3\" وقم بتسجيل الدخول أولاً للاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechseln Sie zum „AO3-Konto“ und melden Sie sich zunächst an, um zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to “AO3 Account” and log in first to import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie a \"Cuenta AO3\" e inicie sesión primero para importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculez vers « Compte AO3 » et connectez-vous d’abord pour importer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"AO3 खाता\" पर स्विच करें और आयात करने के लिए पहले लॉग इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih ke “Akun AO3” dan masuk terlebih dahulu untuk mengimpor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a \"Account AO3\" e accedi prima per importare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「AO3 アカウント」に切り替えてログインしてからインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"AO3 계정\"으로 전환하고 먼저 로그인하여 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel over naar “AO3 Account” en log eerst in om te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do „Konta AO3” i zaloguj się jako pierwszy, aby zaimportować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude para “Conta AO3” e faça login primeiro para importar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключитесь на «Учетную запись AO3» и сначала войдите в систему, чтобы импортировать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to “AO3 Account” and log in first to import."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“AO3 Hesabı”na geçin ve içe aktarmak için önce oturum açın."
          }
        },
        "uk": {
