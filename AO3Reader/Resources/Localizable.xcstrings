    "「自動」會依背景深淺選擇黑色或白色文字。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم \"تلقائي\" باختيار النص باللون الأسود أو الأبيض بناءً على مدى قتامة الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto“ wählt schwarzen oder weißen Text aus, je nachdem, wie dunkel der Hintergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” picks black or white text based on how dark the background is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" selecciona texto en blanco o negro según lo oscuro que sea el fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Auto » sélectionne le texte en noir ou blanc en fonction de l'obscurité de l'arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि कितनी गहरी है, इसके आधार पर \"ऑटो\" काले या सफेद टेक्स्ट का चयन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatis” mengambil teks hitam atau putih berdasarkan seberapa gelap latar belakangnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" seleziona il testo in bianco o nero in base a quanto è scuro lo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、背景の暗さに基づいて黒または白のテキストが選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자동”은 배경이 얼마나 어두운지에 따라 검은색 또는 흰색 텍스트를 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” kiest zwarte of witte tekst op basis van hoe donker de achtergrond is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto” wybiera czarny lub biały tekst na podstawie ciemnego tła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automático” escolhe texto em preto ou branco com base na escuridão do fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» выбирает черный или белый текст в зависимости от темности фона."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“อัตโนมัติ” เลือกข้อความสีดำหรือสีขาวตามความเข้มของพื้นหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatik”, arka planın ne kadar karanlık olduğuna bağlı olarak siyah veya beyaz metni seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» вибирає чорний або білий текст залежно від темного фону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tự động” chọn văn bản màu đen hoặc trắng dựa trên độ tối của nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」会依背景深浅选择黑色或白色文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        }
      }
    },
