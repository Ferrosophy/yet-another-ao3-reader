    "輸入合集標題；不輸入直接按搜尋可瀏覽全部合集": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان المجموعة، أو ابحث بدون إدخال أي شيء لتصفح جميع المجموعات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Sammlungstitel ein oder suchen Sie ohne Eingaben, um alle Sammlungen zu durchsuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a collection title, or search with nothing entered to browse all collections"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese el título de una colección o busque sin ingresar nada para explorar todas las colecciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez un titre de collection ou effectuez une recherche sans rien saisir pour parcourir toutes les collections"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक संग्रह शीर्षक दर्ज करें, या सभी संग्रह ब्राउज़ करने के लिए कुछ भी दर्ज किए बिना खोजें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan judul koleksi, atau cari tanpa memasukkan apa pun untuk menelusuri semua koleksi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il titolo di una raccolta o esegui una ricerca senza inserire nulla per sfogliare tutte le raccolte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションのタイトルを入力するか、何も入力せずに検索してすべてのコレクションを参照します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컬렉션 제목을 입력하거나, 아무것도 입력하지 않고 검색하여 모든 컬렉션을 찾아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een collectietitel in of zoek zonder iets in te voeren om door alle collecties te bladeren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź tytuł kolekcji lub wyszukaj bez wpisania, aby przeglądać wszystkie kolekcje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um título de coleção ou pesquise sem inserir nada para navegar por todas as coleções"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название коллекции или выполните поиск, ничего не вводя, чтобы просмотреть все коллекции."
          }
        },
        "th": {
