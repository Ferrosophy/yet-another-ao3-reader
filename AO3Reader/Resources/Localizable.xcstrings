        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線保存"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "離線保存"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
