    "輸入至少兩個字會向 AO3 查找匹配的標籤，點選即可加入。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب حرفين على الأقل للبحث عن علامات AO3 المطابقة، ثم اضغط على أحدهما لإضافته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie mindestens zwei Zeichen ein, um nach passenden AO3-Tags zu suchen, und tippen Sie dann auf eines, um es hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type at least two characters to look up matching AO3 tags, then tap one to add it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba al menos dos caracteres para buscar etiquetas AO3 coincidentes y luego toque uno para agregarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez au moins deux caractères pour rechercher les balises AO3 correspondantes, puis appuyez sur une pour l'ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेल खाते AO3 टैग देखने के लिए कम से कम दो अक्षर टाइप करें, फिर इसे जोड़ने के लिए एक पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik setidaknya dua karakter untuk mencari tag AO3 yang cocok, lalu ketuk salah satu karakter untuk menambahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita almeno due caratteri per cercare i tag AO3 corrispondenti, quindi toccane uno per aggiungerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも 2 文字を入力して一致する AO3 タグを検索し、1 文字をタップして追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 AO3 태그를 찾으려면 두 개 이상의 문자를 입력한 다음 하나를 탭하여 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ minimaal twee tekens om overeenkomende AO3-tags op te zoeken en tik vervolgens op één om deze toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz co najmniej dwa znaki, aby wyszukać pasujące tagi AO3, a następnie stuknij jeden, aby go dodać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite pelo menos dois caracteres para procurar tags AO3 correspondentes e toque em um para adicioná-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите не менее двух символов, чтобы найти соответствующие теги AO3, затем нажмите один, чтобы добавить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์อักขระอย่างน้อยสองตัวเพื่อค้นหาแท็ก AO3 ที่ตรงกัน จากนั้นแตะหนึ่งตัวเพื่อเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen AO3 etiketlerini aramak için en az iki karakter yazın, ardından eklemek için birine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть принаймні два символи, щоб знайти відповідні теги AO3, а потім натисніть один, щоб додати його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập ít nhất hai ký tự để tra cứu các thẻ AO3 phù hợp, sau đó nhấn vào một ký tự để thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入至少两个字会向 AO3 查找匹配的标签，点击即可加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入至少兩個字會向 AO3 查找匹配的標籤，點選即可加入。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
