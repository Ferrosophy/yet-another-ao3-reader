    "回應不像 AO3 頁面，可能不是相容的鏡像": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستجابة لا تبدو مثل AO3. قد لا تكون هذه مرآة متوافقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort sieht nicht wie AO3 aus. Dies ist möglicherweise kein kompatibler Spiegel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response doesn't look like AO3. This may not be a compatible mirror."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta no se parece a AO3. Puede que este no sea un espejo compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse ne ressemble pas à AO3. Ce n'est peut-être pas un miroir compatible."
