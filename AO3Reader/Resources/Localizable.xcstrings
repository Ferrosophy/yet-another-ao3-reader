    "滾動與翻頁模式各自保存排版。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ أوضاع التمرير والمقسم إلى صفحات بإعدادات التخطيط الخاصة بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scroll- und der Seitenmodus behalten ihre eigenen Layouteinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and paged modes keep their own layout settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modos de desplazamiento y paginación mantienen sus propias configuraciones de diseño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modes de défilement et paginé conservent leurs propres paramètres de mise en page."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रॉल और पृष्ठांकित मोड अपनी स्वयं की लेआउट सेटिंग्स रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode gulir dan halaman mempertahankan pengaturan tata letaknya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modalità di scorrimento e impaginazione mantengono le proprie impostazioni di layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール モードとページ モードでは、独自のレイアウト設定が保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 및 페이지 모드는 자체 레이아웃 설정을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scroll- en paged-modi behouden hun eigen lay-outinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryby przewijania i stronicowania zachowują własne ustawienia układu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modos de rolagem e paginação mantêm suas próprias configurações de layout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы прокрутки и постраничного просмотра сохраняют свои собственные настройки макета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดเลื่อนและเพจจะเก็บการตั้งค่าเค้าโครงของตัวเองไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma ve sayfalı modlar kendi düzen ayarlarını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У режимах прокручування та сторінках зберігаються власні налаштування макета."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ cuộn và phân trang giữ cài đặt bố cục của riêng chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动与翻页模式各自保存排版。"
          }
        },
        "zh-Hant": {
