    "淺色與深色模式各自保存背景與文字顏色，跟隨系統切換。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ كل من الوضعين الفاتح والداكن بألوان الخلفية والنص الخاصة به ويتبادلان مع النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hell- und der Dunkelmodus behalten jeweils ihre eigenen Hintergrund- und Textfarben und wechseln mit dem System."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light and Dark Mode each keep their own background and text colors and switch with the system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modos claro y oscuro mantienen cada uno sus propios colores de fondo y texto y cambian con el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modes clair et sombre conservent chacun leurs propres couleurs d'arrière-plan et de texte et commutent avec le système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइट और डार्क मोड प्रत्येक अपना स्वयं का पृष्ठभूमि और टेक्स्ट रंग रखते हैं और सिस्टम के साथ स्विच करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Terang dan Gelap masing-masing mempertahankan warna latar belakang dan teksnya sendiri dan beralih sesuai sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modalità Chiaro e Scuro mantengono ciascuna il proprio sfondo e i colori del testo e cambiano con il sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト モードとダーク モードはそれぞれ独自の背景とテキストの色を保持し、システムに応じて切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 모드와 어두운 모드는 각각 고유한 배경색과 텍스트 색상을 유지하고 시스템에 따라 전환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lichte en donkere modus behouden elk hun eigen achtergrond- en tekstkleuren en schakelen mee met het systeem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb jasny i ciemny zachowują własne kolory tła i tekstu i przełączają się wraz z systemem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modos Claro e Escuro mantêm suas próprias cores de fundo e texto e alternam com o sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлый и темный режимы сохраняют свои собственные цвета фона и текста и переключаются вместе с системой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดแสงและความมืดแต่ละโหมดจะเก็บพื้นหลังและสีข้อความของตนเองไว้ และสลับไปตามระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık ve Koyu Modun her biri kendi arka plan ve metin renklerini korur ve sistemle geçiş yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світлий і темний режими зберігають власні кольори фону та тексту та перемикаються разом із системою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi Chế độ Sáng và Tối đều giữ màu nền và văn bản riêng và chuyển đổi theo hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色与深色模式各自保存背景与文本颜色，跟随系统切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色與深色模式各自保存背景與文字顏色，跟隨系統切換。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色與深色模式各自保存背景與文字顏色，跟隨系統切換。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色與深色模式各自保存背景與文字顏色，跟隨系統切換。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色與深色模式各自保存背景與文字顏色，跟隨系統切換。"
          }
        }
      }
