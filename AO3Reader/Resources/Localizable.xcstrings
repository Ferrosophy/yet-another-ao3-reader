    "「自動」會依正文顏色產生淡色底，與閱讀背景融為一體。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم \"تلقائي\" بإنشاء لون فاتح من لون النص الذي يمتزج مع خلفية القراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto“ erzeugt einen hellen Farbton aus der Textfarbe, der mit dem Lesehintergrund verschmilzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” creates a light tint from the text color that blends with the reading background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" crea un matiz claro a partir del color del texto que se mezcla con el fondo de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Auto » crée une légère teinte à partir de la couleur du texte qui se fond dans l'arrière-plan de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ऑटो\" टेक्स्ट रंग से एक हल्का रंग बनाता है जो पढ़ने की पृष्ठभूमि के साथ मिश्रित होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatis” menciptakan rona terang dari warna teks yang menyatu dengan latar belakang pembacaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" crea una sfumatura chiara dal colore del testo che si fonde con lo sfondo della lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、テキストの色から明るい色合いが作成され、読書の背景と溶け合います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"자동\"은 읽기 배경과 혼합되는 텍스트 색상에서 밝은 색조를 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” creëert een lichte tint van de tekstkleur die overvloeit met de leesachtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto” tworzy jasny odcień na podstawie koloru tekstu, który zlewa się z tłem czytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” cria um tom claro a partir da cor do texto que combina com o fundo de leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» создает легкий оттенок цвета текста, который сливается с фоном чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“อัตโนมัติ” สร้างสีอ่อนจากสีข้อความที่กลมกลืนกับพื้นหลังการอ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatik”, metin renginden okuma arka planıyla harmanlanan açık bir renk tonu oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» створює легкий відтінок кольору тексту, який зливається з фоном для читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tự động” tạo ra tông màu sáng từ màu văn bản hòa với nền đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」会依正文颜色产生淡色底，与阅读背景融为一体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依正文顏色產生淡色底，與閱讀背景融為一體。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依正文顏色產生淡色底，與閱讀背景融為一體。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依正文顏色產生淡色底，與閱讀背景融為一體。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依正文顏色產生淡色底，與閱讀背景融為一體。"
          }
        }
      }
    },
    "「自動」會依背景深淺選擇黑色或白色文字。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم \"تلقائي\" باختيار النص باللون الأسود أو الأبيض بناءً على مدى قتامة الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto“ wählt schwarzen oder weißen Text aus, je nachdem, wie dunkel der Hintergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” picks black or white text based on how dark the background is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" selecciona texto en blanco o negro según lo oscuro que sea el fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Auto » sélectionne le texte en noir ou blanc en fonction de l'obscurité de l'arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि कितनी गहरी है, इसके आधार पर \"ऑटो\" काले या सफेद टेक्स्ट का चयन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatis” mengambil teks hitam atau putih berdasarkan seberapa gelap latar belakangnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" seleziona il testo in bianco o nero in base a quanto è scuro lo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、背景の暗さに基づいて黒または白のテキストが選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자동”은 배경이 얼마나 어두운지에 따라 검은색 또는 흰색 텍스트를 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” kiest zwarte of witte tekst op basis van hoe donker de achtergrond is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto” wybiera czarny lub biały tekst na podstawie ciemnego tła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automático” escolhe texto em preto ou branco com base na escuridão do fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» выбирает черный или белый текст в зависимости от темности фона."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“อัตโนมัติ” เลือกข้อความสีดำหรือสีขาวตามความเข้มของพื้นหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Otomatik”, arka planın ne kadar karanlık olduğuna bağlı olarak siyah veya beyaz metni seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Авто» вибирає чорний або білий текст залежно від темного фону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tự động” chọn văn bản màu đen hoặc trắng dựa trên độ tối của nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」会依背景深浅选择黑色或白色文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會依背景深淺選擇黑色或白色文字。"
          }
        }
      }
    },
    "「自動」與正文顏色相同。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم \"تلقائي\" نفس لون النص الأساسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto“ verwendet dieselbe Farbe wie der Textkörper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” uses the same color as the body text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Auto” usa el mismo color que el texto del cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Auto » utilise la même couleur que le corps du texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ऑटो\" मुख्य पाठ के समान रंग का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Otomatis\" menggunakan warna yang sama dengan teks isi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" utilizza lo stesso colore del corpo del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」は本文と同じ色になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'자동'은 본문 텍스트와 동일한 색상을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
