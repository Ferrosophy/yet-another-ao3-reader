    "翻譯會使用付費 API，長按確認後開始": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الترجمة واجهة برمجة التطبيقات المدفوعة. اضغط لفترة طويلة للتأكيد والبدء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersetzung verwendet eine kostenpflichtige API. Zum Bestätigen und Starten lange drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation uses a paid API. Long-press to confirm and start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción utiliza una API paga. Mantenga presionado para confirmar y comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction utilise une API payante. Appuyez longuement pour confirmer et démarrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुवाद एक सशुल्क एपीआई का उपयोग करता है। पुष्टि करने और प्रारंभ करने के लिए देर तक दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan menggunakan API berbayar. Tekan lama untuk mengonfirmasi dan memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione utilizza un'API a pagamento. Premere a lungo per confermare e iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳には有料APIを使用します。長押しして確定し、開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 유료 API를 사용합니다. 확인하고 시작하려면 길게 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaling maakt gebruik van een betaalde API. Druk lang om te bevestigen en te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenie korzysta z płatnego API. Naciśnij długo, aby potwierdzić i rozpocząć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução usa uma API paga. Pressione longamente para confirmar e iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод использует платный API. Нажмите и удерживайте, чтобы подтвердить и начать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลใช้ API แบบชำระเงิน กดแบบยาวเพื่อยืนยันและเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri ücretli bir API kullanır. Onaylamak ve başlatmak için uzun basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перекладу використовується платний API. Натисніть і утримуйте, щоб підтвердити та почати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dịch sử dụng API trả phí. Nhấn và giữ để xác nhận và bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译会使用付费 API，长按确认后开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯會使用付費 API，長按確認後開始"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
