    "帳戶資訊 › 安全選項 › 第三方應用管理 › 添加應用，名稱填 YAAO3R。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات الحساب › الأمان › تطبيقات الطرف الثالث › أضف تطبيقًا، وقم بتسميته YAAO3R."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoinformationen › Sicherheit › Drittanbieter-Apps › App hinzufügen und nennen Sie sie YAAO3R."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Info › Security › Third-Party Apps › Add App, and name it YAAO3R."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información de cuenta › Seguridad › Aplicaciones de terceros › Agregar aplicación y asígnele el nombre YAAO3R."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations sur le compte › Sécurité › Applications tierces › Ajoutez une application et nommez-la YAAO3R."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता जानकारी › सुरक्षा › तृतीय-पक्ष ऐप्स › ऐप जोड़ें, और इसे YAAO3R नाम दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Info Akun › Keamanan › Aplikasi Pihak Ketiga › Tambah Aplikasi, dan beri nama YAAO3R."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni sull'account › Sicurezza › App di terze parti › Aggiungi app e chiamala YAAO3R."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント情報 › セキュリティ › サードパーティ アプリ › アプリを追加し、YAAO3R という名前を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 정보 › 보안 › 타사 앱 › 앱을 추가하고 이름을 YAAO3R로 지정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountinfo › Beveiliging › Apps van derden › App toevoegen en deze YAAO3R noemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje o koncie > Bezpieczeństwo > Aplikacje innych firm > Dodaj aplikację i nadaj jej nazwę YAAO3R."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informações da conta › Segurança › Aplicativos de terceiros › Adicionar aplicativo e nomeie-o como YAAO3R."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация об учетной записи › Безопасность › Сторонние приложения › Добавьте приложение и назовите его YAAO3R."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลบัญชี › ความปลอดภัย › แอปของบุคคลที่สาม › เพิ่มแอป และตั้งชื่อเป็น YAAO3R"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap Bilgileri › Güvenlik › Üçüncü Taraf Uygulamalar › Uygulamayı ekleyin ve YAAO3R olarak adlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація про обліковий запис › Безпека › Програми сторонніх розробників › Додайте програму та назвіть її YAAO3R."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin tài khoản > Bảo mật > Ứng dụng của bên thứ ba > Thêm ứng dụng và đặt tên là YAAO3R."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户信息 › 安全选项 › 第三方应用管理 › 添加应用，名称填 YAAO3R。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶資訊 › 安全選項 › 第三方應用管理 › 添加應用，名稱填 YAAO3R。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶資訊 › 安全選項 › 第三方應用管理 › 添加應用，名稱填 YAAO3R。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶資訊 › 安全選項 › 第三方應用管理 › 添加應用，名稱填 YAAO3R。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶資訊 › 安全選項 › 第三方應用管理 › 添加應用，名稱填 YAAO3R。"
          }
        }
      }
