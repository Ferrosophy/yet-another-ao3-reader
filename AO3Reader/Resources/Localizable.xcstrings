    "來源要求瀏覽器驗證，請改用「網頁登入」通過驗證後再試": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا المصدر التحقق من المتصفح. استخدم \"تسجيل الدخول عبر الويب\" لاجتياز الفحص، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle erfordert eine Browserüberprüfung. Verwenden Sie „Web Login“, um die Prüfung zu bestehen, und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source requires browser verification. Use “Web Login” to pass the check, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente requiere verificación del navegador. Utilice \"Inicio de sesión web\" para aprobar la verificación y luego inténtelo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source nécessite une vérification du navigateur. Utilisez « Web Login » pour réussir le contrôle, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्रोत को ब्राउज़र सत्यापन की आवश्यकता है. चेक पास करने के लिए \"वेब लॉगिन\" का उपयोग करें, फिर पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber ini memerlukan verifikasi browser. Gunakan “Login Web” untuk lulus pemeriksaan, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fonte richiede la verifica del browser. Utilizza \"Accesso Web\" per superare il controllo, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースにはブラウザの検証が必要です。 「Web ログイン」を使用してチェックに合格し、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스에는 브라우저 확인이 필요합니다. “웹 로그인”을 사용하여 검사를 통과한 후 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze bron is browserverificatie vereist. Gebruik “Web Login” om de controle te doorstaan ​​en probeer het vervolgens opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To źródło wymaga weryfikacji przeglądarki. Użyj opcji „Logowanie przez Internet”, aby przejść kontrolę, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fonte requer verificação do navegador. Use “Web Login” para passar na verificação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот источник требует проверки браузера. Используйте «Вход в Интернет», чтобы пройти проверку, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แหล่งที่มานี้ต้องมีการยืนยันเบราว์เซอร์ ใช้ “เข้าสู่ระบบเว็บ” เพื่อผ่านการตรวจสอบแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaynak tarayıcı doğrulamasını gerektiriyor. Kontrolü geçmek için “Web Girişi”ni kullanın ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
