    "沒有相簿權限，請在「設定」中允許 YAAO3R 加入照片": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى الصور. اسمح لـ YAAO3R بإضافة الصور في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Fotos. Erlauben Sie YAAO3R, Fotos in den Einstellungen hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to Photos. Allow YAAO3R to add photos in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Fotos. Permita que YAAO3R agregue fotos en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'accès aux photos. Autorisez YAAO3R à ajouter des photos dans Paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो तक पहुंच नहीं. YAAO3R को सेटिंग्स में फ़ोटो जोड़ने की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada akses ke Foto. Izinkan YAAO3R menambahkan foto di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso alle foto. Consenti a YAAO3R di aggiungere foto nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真にアクセスできません。 YAAO3R が設定で写真を追加できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진에 액세스할 수 없습니다. YAAO3R이 설정에서 사진을 추가하도록 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot Foto's. Sta YAAO3R toe om foto's toe te voegen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do zdjęć. Zezwól YAAO3R na dodawanie zdjęć w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso às fotos. Permita que YAAO3R adicione fotos em Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к фотографиям. Разрешите YAAO3R добавлять фотографии в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงรูปถ่าย อนุญาตให้ YAAO3R เพิ่มรูปภาพในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar'a erişim yok. YAAO3R'nin Ayarlar'da fotoğraf eklemesine izin verin."
          }
