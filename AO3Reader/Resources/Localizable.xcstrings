          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "請從多工畫面關閉 App 後重新開啟。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請從多工畫面關閉 App 後重新開啟。"
          }
        }
      }
    },
    "請求過於頻繁，AO3 暫時限制存取": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة جدًا. AO3 لديه وصول محدود مؤقتا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. AO3 hat vorübergehend eingeschränkten Zugang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. AO3 has temporarily limited access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes. AO3 tiene acceso limitado temporalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes. AO3 a temporairement limité l’accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत सारे अनुरोध. AO3 की पहुंच अस्थायी रूप से सीमित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan. AO3 untuk sementara waktu membatasi akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste. AO3 ha temporaneamente accesso limitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。 AO3 は一時的にアクセスが制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많습니다. AO3는 일시적으로 접근이 제한되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. AO3 heeft tijdelijk beperkte toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele żądań. AO3 ma tymczasowo ograniczony dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos pedidos. O AO3 tem acesso temporariamente limitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. AO3 временно ограничил доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอมากเกินไป AO3 ถูกจำกัดการเข้าถึงชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla istek var. AO3'ün erişimi geçici olarak sınırlandırılmıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато запитів. AO3 має тимчасово обмежений доступ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều yêu cầu. AO3 tạm thời hạn chế quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过于频繁，AO3 暂时限制访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取"
          }
        }
      }
    },
    "請求過於頻繁，AO3 暫時限制存取，請於 %@ 秒後再試": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة جدًا. AO3 لديه وصول محدود مؤقتا. حاول مرة أخرى خلال %@ ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen. AO3 hat vorübergehend eingeschränkten Zugang. Versuchen Sie es in %@ Sekunden erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. AO3 has temporarily limited access. Try again in %@ seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas solicitudes. AO3 tiene acceso limitado temporalmente. Inténtalo de nuevo en %@ segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes. AO3 a temporairement limité l’accès. Réessayez dans %@ secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत सारे अनुरोध. AO3 की पहुंच अस्थायी रूप से सीमित है। %@ सेकंड में पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan. AO3 untuk sementara waktu membatasi akses. Coba lagi dalam %@ detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe richieste. AO3 ha temporaneamente accesso limitato. Riprova tra %@ secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます。 AO3 は一時的にアクセスが制限されています。 %@ 秒後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 많습니다. AO3는 일시적으로 접근이 제한되었습니다. %@초 후에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel verzoeken. AO3 heeft tijdelijk beperkte toegang. Probeer het over %@ seconden opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele żądań. AO3 ma tymczasowo ograniczony dostęp. Spróbuj ponownie za %@ sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos pedidos. O AO3 tem acesso temporariamente limitado. Tente novamente em %@ segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. AO3 временно ограничил доступ. Повторите попытку через %@ секунд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอมากเกินไป AO3 ถูกจำกัดการเข้าถึงชั่วคราว ลองอีกครั้งใน %@ วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla istek var. AO3'ün erişimi geçici olarak sınırlandırılmıştır. %@ saniye sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато запитів. AO3 має тимчасово обмежений доступ. Повторіть спробу через %@ секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều yêu cầu. AO3 tạm thời hạn chế quyền truy cập. Hãy thử lại sau %@ giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过于频繁，AO3 暂时限制访问，请于 %@ 秒后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取，請於 %@ 秒後再試"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取，請於 %@ 秒後再試"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取，請於 %@ 秒後再試"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請求過於頻繁，AO3 暫時限制存取，請於 %@ 秒後再試"
          }
        }
      }
