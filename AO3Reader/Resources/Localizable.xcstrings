        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन विफल. अपना उपयोगकर्ता नाम और पासवर्ड जांचें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal masuk. Periksa nama pengguna dan kata sandi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso non riuscito. Controlla il tuo nome utente e la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインに失敗しました。ユーザー名とパスワードを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인에 실패했습니다. 사용자 이름과 비밀번호를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen mislukt. Controleer uw gebruikersnaam en wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie nie powiodło się. Sprawdź swoją nazwę użytkownika i hasło."
          }
        },
