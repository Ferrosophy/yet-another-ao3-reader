    "請從多工畫面關閉 App 後重新開啟。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق التطبيق من مبدل التطبيقات، ثم افتحه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die App über den App-Umschalter und öffnen Sie sie dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app from the app switcher, then open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la aplicación desde el selector de aplicaciones y luego ábrela nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez l'application à partir du sélecteur d'applications, puis rouvrez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप स्विचर से ऐप को बंद करें, फिर इसे दोबारा खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup aplikasi dari pengalih aplikasi, lalu buka lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi l'app dal commutatore di app, quindi aprila di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリスイッチャーからアプリを閉じて、再度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전환기에서 앱을 닫았다가 다시 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app via de app-switcher en open deze vervolgens opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij aplikację za pomocą przełącznika aplikacji, a następnie otwórz ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o aplicativo no alternador de aplicativos e abra-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте приложение с помощью переключателя приложений, а затем откройте его снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดแอพจากตัวสลับแอพ แล้วเปิดใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama değiştiriciden uygulamayı kapatın, ardından tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте програму з перемикача програм, а потім відкрийте її знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng ứng dụng từ trình chuyển đổi ứng dụng, sau đó mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从多任务画面关闭 App 后重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從多工畫面關閉 App 後重新開啟。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請從多工畫面關閉 App 後重新開啟。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "請從多工畫面關閉 App 後重新開啟。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請從多工畫面關閉 App 後重新開啟。"
          }
        }
      }
    },
