    "自動配色會依正文顏色產生淡色底，與閱讀背景融為一體。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الألوان التلقائية صبغة خفيفة من لون النص بحيث تمتزج العلامات مع خلفية القراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Farben verwenden einen leichten Farbton der Textfarbe, sodass Tags mit dem Lesehintergrund verschmelzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic colors use a light tint of the text color so tags blend with the reading background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores automáticos utilizan un tono claro del color del texto para que las etiquetas se mezclen con el fondo de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs automatiques utilisent une légère teinte de la couleur du texte afin que les balises se fondent dans l’arrière-plan de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित रंग टेक्स्ट रंग के हल्के रंग का उपयोग करते हैं ताकि टैग पढ़ने की पृष्ठभूमि के साथ मिश्रित हो जाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna otomatis menggunakan rona terang pada warna teks sehingga tag menyatu dengan latar belakang pembacaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colori automatici utilizzano una tonalità chiara del colore del testo in modo che i tag si fondano con lo sfondo di lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動カラーではテキストの色の明るい色合いが使用されるため、タグが読書の背景に溶け込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 색상은 텍스트 색상의 밝은 색조를 사용하므로 태그가 읽기 배경과 혼합됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische kleuren gebruiken een lichte tint van de tekstkleur, zodat tags opgaan in de leesachtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory automatyczne wykorzystują jasny odcień koloru tekstu, dzięki czemu znaczniki zlewają się z tłem do czytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores automáticas usam um tom claro da cor do texto para que as tags se misturem ao fundo de leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматические цвета используют светлый оттенок цвета текста, поэтому теги сливаются с фоном чтения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีอัตโนมัติจะใช้สีอ่อนของสีข้อความเพื่อให้แท็กผสมผสานกับพื้นหลังการอ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik renkler, metin renginin açık bir tonunu kullanır, böylece etiketler okuma arka planıyla karışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичні кольори використовують легкий відтінок кольору тексту, щоб теги зливалися з фоном читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu tự động sử dụng tông màu nhạt của màu văn bản để thẻ hòa hợp với nền đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动配色会依正文颜色产生淡色底，与阅读背景融为一体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動配色會依正文顏色產生淡色底，與閱讀背景融為一體。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
