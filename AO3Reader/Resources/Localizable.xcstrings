    "同一部作品的時間會計入它的每一個 Fandom、配對、角色與其他標籤。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم احتساب الوقت المستغرق في العمل في كل من قاعدته الجماهيرية وعلاقاته وشخصياته وعلاماته الإضافية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die für ein Werk aufgewendete Zeit wird auf jedes seiner Fandoms, Beziehungen, Charaktere und zusätzlichen Tags angerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time spent on a work counts toward each of its fandoms, relationships, characters and additional tags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo dedicado a una obra cuenta para cada uno de sus fandoms, relaciones, personajes y etiquetas adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps passé sur une œuvre compte pour chacun de ses fandoms, relations, personnages et balises supplémentaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कार्य पर बिताया गया समय उसके प्रत्येक प्रशंसकों, रिश्तों, पात्रों और अतिरिक्त टैग के लिए गिना जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu yang dihabiskan untuk sebuah karya diperhitungkan dalam setiap fandom, hubungan, karakter, dan tag tambahannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo trascorso su un'opera conta per ciascuno dei suoi fandom, relazioni, personaggi e tag aggiuntivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品に費やした時間は、ファンダム、人間関係、キャラクター、追加タグのそれぞれにカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작품에 소요된 시간은 각 팬덤, 관계, 캐릭터 및 추가 태그에 반영됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijd die aan een werk wordt besteed, telt mee voor elk van zijn fandoms, relaties, personages en aanvullende tags."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas spędzony nad dziełem wlicza się do każdego z jego fandomów, relacji, postaci i dodatkowych tagów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo gasto em uma obra conta para cada um de seus fandoms, relacionamentos, personagens e tags adicionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время, потраченное на произведение, учитывается для каждого из его фандомов, отношений, персонажей и дополнительных тегов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาที่ใช้ในงานจะนับรวมตามแฟนด้อม ความสัมพันธ์ ตัวละคร และแท็กเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eser üzerinde harcanan zaman, o eserin fandomlarının, ilişkilerinin, karakterlerinin ve ek etiketlerinin her biri için sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час, витрачений на роботу, зараховується до кожного з її фандомів, стосунків, персонажів і додаткових тегів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian dành cho một tác phẩm được tính vào từng fandom, mối quan hệ, nhân vật và các thẻ bổ sung của tác phẩm đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一部作品的时间会计入它的每一个 Fandom、配对、角色与其他标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一部作品的時間會計入它的每一個 Fandom、配對、角色與其他標籤。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "同一部作品的時間會計入它的每一個 Fandom、配對、角色與其他標籤。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "同一部作品的時間會計入它的每一個 Fandom、配對、角色與其他標籤。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "同一部作品的時間會計入它的每一個 Fandom、配對、角色與其他標籤。"
          }
        }
      }
    },
