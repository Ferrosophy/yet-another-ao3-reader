    "%@ 需要驗證，請在彈出的網頁中完成後重試": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يحتاج إلى التحقق. أكمله على الصفحة التي تفتح، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss überprüft werden. Vervollständigen Sie den Vorgang auf der Seite, die geöffnet wird, und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs verification. Complete it on the page that opens, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita verificación. Complételo en la página que se abre y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être vérifié. Complétez-le sur la page qui s'ouvre, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सत्यापन की आवश्यकता है। खुलने वाले पृष्ठ पर इसे पूरा करें, फिर पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ perlu verifikasi. Selesaikan di halaman yang terbuka, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necessita di verifica. Completalo nella pagina che si apre, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は確認が必要です。開いたページで入力を完了してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 확인이 필요합니다. 열리는 페이지에서 작성을 완료한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft verificatie nodig. Vul het in op de pagina die wordt geopend en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga weryfikacji. Wypełnij go na stronie, która się otworzy, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa de verificação. Conclua-o na página exibida e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ требует проверки. Завершите его на открывшейся странице и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต้องการการยืนยัน กรอกข้อมูลในหน้าที่เปิดขึ้นมาแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'ın doğrulanması gerekiyor. Açılan sayfada işlemi tamamlayıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ потребує перевірки. Завершіть його на сторінці, що відкриється, а потім повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cần xác minh. Hãy hoàn thành nó trên trang mở ra, sau đó thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要验证，请在弹出的网页中完成后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要驗證，請在彈出的網頁中完成後重試"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要驗證，請在彈出的網頁中完成後重試"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要驗證，請在彈出的網頁中完成後重試"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要驗證，請在彈出的網頁中完成後重試"
          }
        }
      }
    },
