    "點「儲存並測試連線」，成功後點「立即同步」。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على \"حفظ واختبار الاتصال\"، ثم \"المزامنة الآن\" بمجرد نجاحها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Verbindung speichern und testen“ und dann auf „Jetzt synchronisieren“, sobald der Vorgang erfolgreich war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Save and Test Connection”, then “Sync Now” once it succeeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque \"Guardar y probar conexión\", luego \"Sincronizar ahora\" una vez que tenga éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Enregistrer et tester la connexion », puis sur « Synchroniser maintenant » une fois l'opération réussie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफल होने पर \"सहेजें और परीक्षण कनेक्शन\" पर टैप करें, फिर \"अभी सिंक करें\" पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk “Simpan dan Uji Koneksi”, lalu “Sinkronkan Sekarang” setelah berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca \"Salva e prova connessione\", quindi \"Sincronizza ora\" una volta completata l'operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「保存して接続をテスト」をタップし、成功したら「今すぐ同期」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"저장 및 연결 테스트\"를 누른 다음 성공하면 \"지금 동기화\"를 누릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'Verbinding opslaan en testen' en vervolgens op 'Nu synchroniseren' zodra dit is gelukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „Zapisz i przetestuj połączenie”, a gdy się powiedzie, „Synchronizuj teraz”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Salvar e testar conexão” e depois em “Sincronizar agora” quando tiver sucesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Сохранить и проверить соединение», затем «Синхронизировать сейчас», как только все получится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ \"บันทึกและทดสอบการเชื่อมต่อ\" จากนั้น \"ซิงค์ทันที\" เมื่อดำเนินการสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bağlantıyı Kaydet ve Test Et”e, ardından başarılı olduğunda “Şimdi Senkronize Et”e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Зберегти та перевірити з’єднання», а потім «Синхронізувати зараз», коли це вдасться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào “Lưu và kiểm tra kết nối”, sau đó “Đồng bộ hóa ngay” sau khi thành công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「保存并测试连接」，成功后点「立即同步」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點「儲存並測試連線」，成功後點「立即同步」。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點「儲存並測試連線」，成功後點「立即同步」。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "點「儲存並測試連線」，成功後點「立即同步」。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "點「儲存並測試連線」，成功後點「立即同步」。"
          }
        }
      }
    },
