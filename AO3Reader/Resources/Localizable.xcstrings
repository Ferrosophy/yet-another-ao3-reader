    "每行一個來源，可寫成「網址」或「名稱 網址」。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصدر واحد في كل سطر، مثل \"URL\" أو \"اسم URL\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Quelle pro Zeile, als „URL“ oder „Namens-URL“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One source per line, as “URL” or “Name URL”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fuente por línea, como \"URL\" o \"Nombre URL\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une source par ligne, comme « URL » ou « Nom URL »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति पंक्ति एक स्रोत, \"यूआरएल\" या \"नाम यूआरएल\" के रूप में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu sumber per baris, sebagai “URL” atau “URL Nama”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fonte per riga, come \"URL\" o \"URL nome\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「URL」または「名前 URL」として、1 行に 1 つのソースを指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나의 소스('URL' 또는 '이름 URL')입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén bron per regel, als “URL” of “Naam-URL”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno źródło w wierszu, jako „URL” lub „Nazwa URL”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fonte por linha, como “URL” ou “Nome URL”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один источник в каждой строке, например «URL» или «URL-адрес имени»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แหล่งที่มาหนึ่งรายการต่อบรรทัดเป็น \"URL\" หรือ \"URL ชื่อ\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satıra \"URL\" veya \"Ad URL'si\" olarak bir kaynak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне джерело на рядок, як «URL» або «Name URL»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nguồn trên mỗi dòng, dưới dạng “URL” hoặc “URL tên”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
