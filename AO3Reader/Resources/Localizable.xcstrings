        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає доступу до фотографій. Дозвольте YAAO3R додавати фотографії в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền truy cập vào Ảnh. Cho phép YAAO3R thêm ảnh trong Cài đặt."
