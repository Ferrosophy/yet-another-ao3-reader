    "登入失敗，請檢查帳號密碼": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الدخول. تحقق من اسم المستخدم وكلمة المرور الخاصة بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist fehlgeschlagen. Überprüfen Sie Ihren Benutzernamen und Ihr Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login failed. Check your username and password."
          }
        },
