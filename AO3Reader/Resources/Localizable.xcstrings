    "無法讀取字體檔，請選擇 .ttf 或 .otf 檔案": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة الخط. اختر ملفًا بتنسيق .ttf أو .otf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schriftart konnte nicht gelesen werden. Wählen Sie eine .ttf- oder .otf-Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the font. Choose a .ttf or .otf file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la fuente. Elija un archivo .ttf o .otf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la police. Choisissez un fichier .ttf ou .otf."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉन्ट नहीं पढ़ सका. कोई .ttf या .otf फ़ाइल चुनें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca fontnya. Pilih file .ttf atau .otf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il carattere. Scegli un file .ttf o .otf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントが読めませんでした。 .ttf または .otf ファイルを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴을 읽을 수 없습니다. .ttf 또는 .otf 파일을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon het lettertype niet lezen. Kies een .ttf- of .otf-bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać czcionki. Wybierz plik .ttf lub .otf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a fonte. Escolha um arquivo .ttf ou .otf."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не смог прочитать шрифт. Выберите файл .ttf или .otf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านแบบอักษรได้ เลือกไฟล์ .ttf หรือ .otf"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı tipi okunamadı. Bir .ttf veya .otf dosyası seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати шрифт. Виберіть файл .ttf або .otf."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc được phông chữ. Chọn tệp .ttf hoặc .otf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取字体文件，请选择 .ttf 或 .otf 文件"
          }
