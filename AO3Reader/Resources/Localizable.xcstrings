            "value": "登录后找到字体文件（.ttf / .otf）并点击下载，下载完成会自动导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後找到字型檔（.ttf / .otf）並點擊下載，下載完成會自動匯入。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後找到字體檔（.ttf / .otf）並點擊下載，下載完成會自動匯入。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
