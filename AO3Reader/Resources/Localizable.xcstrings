    "在 Azure 入口網站建立 Translator 資源後取得金鑰與區域；全域資源可留空。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنشاء مورد مترجم في مدخل Azure للحصول على المفتاح والمنطقة. اترك المنطقة فارغة للموارد العالمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie im Azure-Portal eine Übersetzerressource, um einen Schlüssel und eine Region abzurufen. Lassen Sie die Region für globale Ressourcen leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Translator resource in the Azure portal to get a key and region. Leave the region empty for global resources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree un recurso de traductor en Azure Portal para obtener una clave y una región. Deje la región vacía para los recursos globales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une ressource Traducteur dans le portail Azure pour obtenir une clé et une région. Laissez la région vide pour les ressources globales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी और क्षेत्र प्राप्त करने के लिए Azure पोर्टल में एक अनुवादक संसाधन बनाएँ। वैश्विक संसाधनों के लिए क्षेत्र को खाली छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat sumber daya Penerjemah di portal Microsoft Azure untuk mendapatkan kunci dan wilayah. Biarkan wilayah tersebut kosong untuk sumber daya global."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creare una risorsa Traduttore nel portale di Azure per ottenere una chiave e un'area. Lascia la regione vuota per le risorse globali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure portal で Translator リソースを作成して、キーとリージョンを取得します。グローバル リソース用にリージョンを空のままにしておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure Portal에서 Translator 리소스를 만들어 키와 지역을 가져옵니다. 전역 리소스의 경우 지역을 비워 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een Translator-resource in de Azure Portal om een sleutel en regio op te halen. Laat de regio leeg voor mondiale hulpbronnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz zasób tłumacza w Azure Portal, aby uzyskać klucz i region. Pozostaw region pusty dla zasobów globalnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um recurso Tradutor no portal do Azure para obter uma chave e uma região. Deixe a região vazia para recursos globais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте ресурс переводчика на портале Azure, чтобы получить ключ и регион. Оставьте регион пустым для глобальных ресурсов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างทรัพยากรนักแปลในพอร์ทัล Azure เพื่อรับคีย์และภูมิภาค ปล่อยให้ภูมิภาคว่างไว้สำหรับทรัพยากรทั่วโลก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir anahtar ve bölge almak için Azure portalında bir Çevirmen kaynağı oluşturun. Küresel kaynaklar için bölgeyi boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть ресурс перекладача на порталі Azure, щоб отримати ключ і регіон. Залиште регіон порожнім для глобальних ресурсів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo tài nguyên Trình dịch trong cổng Azure để lấy khóa và vùng. Để trống khu vực cho tài nguyên toàn cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Azure 门户网站创建 Translator 资源后取得密钥与区域；全域资源可留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Azure 入口網站建立 Translator 資源後取得金鑰與區域；全域資源可留空。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Azure 入口網站建立 Translator 資源後取得金鑰與區域；全域資源可留空。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Azure 入口網站建立 Translator 資源後取得金鑰與區域；全域資源可留空。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Azure 入口網站建立 Translator 資源後取得金鑰與區域；全域資源可留空。"
          }
        }
      }
