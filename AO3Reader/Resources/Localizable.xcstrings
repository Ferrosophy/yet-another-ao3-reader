    "請在網頁中完成驗證（如驗證碼），完成後點「完成」重新翻譯。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل عملية التحقق على الصفحة (مثل كلمة التحقق)، ثم اضغط على \"تم\" للترجمة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die Überprüfung auf der Seite ab (z. B. ein Captcha) und tippen Sie dann auf „Fertig“, um die Übersetzung erneut durchzuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete the verification on the page (such as a captcha), then tap Done to translate again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete la verificación en la página (como un captcha), luego toque Listo para traducir nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez la vérification sur la page (comme un captcha), puis appuyez sur Terminé pour traduire à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठ पर सत्यापन पूरा करें (जैसे कैप्चा), फिर दोबारा अनुवाद करने के लिए संपन्न पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan verifikasi pada halaman tersebut (seperti captcha), lalu ketuk Selesai untuk menerjemahkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la verifica sulla pagina (ad esempio un captcha), quindi tocca Fine per tradurre nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上の検証 (キャプチャなど) を完了し、[完了] をタップして再度翻訳します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지에서 인증(예: 보안 문자)을 완료한 다음 완료를 탭하여 다시 번역하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi de verificatie op de pagina (zoals een captcha) en tik vervolgens op Gereed om opnieuw te vertalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ weryfikację na stronie (np. captcha), a następnie dotknij Gotowe, aby przetłumaczyć ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a verificação na página (como um captcha) e toque em Concluído para traduzir novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите проверку на странице (например, с помощью капчи), затем нажмите «Готово», чтобы перевести еще раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการยืนยันบนเพจให้เสร็จสิ้น (เช่น captcha) จากนั้นแตะเสร็จสิ้นเพื่อแปลอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfadaki doğrulamayı (captcha gibi) tamamlayın ve ardından tekrar çevirmek için Bitti'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть перевірку на сторінці (наприклад, captcha), а потім натисніть «Готово», щоб перекласти ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất xác minh trên trang (chẳng hạn như hình ảnh xác thực), sau đó nhấn Xong để dịch lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在网页中完成验证（如验证码），完成后点「完成」重新翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在網頁中完成驗證（如驗證碼），完成後點「完成」重新翻譯。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在網頁中完成驗證（如驗證碼），完成後點「完成」重新翻譯。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "請在網頁中完成驗證（如驗證碼），完成後點「完成」重新翻譯。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請在網頁中完成驗證（如驗證碼），完成後點「完成」重新翻譯。"
          }
        }
      }
    },
    "請從多工畫面關閉 App 後重新開啟。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق التطبيق من مبدل التطبيقات، ثم افتحه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die App über den App-Umschalter und öffnen Sie sie dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app from the app switcher, then open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la aplicación desde el selector de aplicaciones y luego ábrela nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez l'application à partir du sélecteur d'applications, puis rouvrez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप स्विचर से ऐप को बंद करें, फिर इसे दोबारा खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup aplikasi dari pengalih aplikasi, lalu buka lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi l'app dal commutatore di app, quindi aprila di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリスイッチャーからアプリを閉じて、再度開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전환기에서 앱을 닫았다가 다시 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app via de app-switcher en open deze vervolgens opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij aplikację za pomocą przełącznika aplikacji, a następnie otwórz ją ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o aplicativo no alternador de aplicativos e abra-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте приложение с помощью переключателя приложений, а затем откройте его снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดแอพจากตัวสลับแอพ แล้วเปิดใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama değiştiriciden uygulamayı kapatın, ardından tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрийте програму з перемикача програм, а потім відкрийте її знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng ứng dụng từ trình chuyển đổi ứng dụng, sau đó mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从多任务画面关闭 App 后重新打开。"
          }
        },
        "zh-Hant": {
