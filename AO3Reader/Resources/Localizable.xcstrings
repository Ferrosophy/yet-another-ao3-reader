    "切換後請完全關閉並重新開啟 App，介面才會全部換成新語言。": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد التبديل، أغلق التطبيق بالكامل وأعد فتحه حتى تستخدم الواجهة بأكملها اللغة الجديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie nach dem Wechsel die App vollständig und öffnen Sie sie erneut, damit die gesamte Benutzeroberfläche die neue Sprache verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After switching, fully close and reopen the app so the whole interface uses the new language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cambiar, cierre y vuelva a abrir completamente la aplicación para que toda la interfaz utilice el nuevo idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le changement, fermez complètement et rouvrez l'application pour que toute l'interface utilise la nouvelle langue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्विच करने के बाद, ऐप को पूरी तरह से बंद करें और दोबारा खोलें ताकि पूरा इंटरफ़ेस नई भाषा का उपयोग कर सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah beralih, tutup sepenuhnya dan buka kembali aplikasi sehingga seluruh antarmuka menggunakan bahasa baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo il passaggio, chiudi e riapri completamente l'app in modo che l'intera interfaccia utilizzi la nuova lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え後、アプリを完全に閉じて再度開くと、インターフェース全体で新しい言語が使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 후 전체 인터페이스가 새 언어를 사용하도록 앱을 완전히 닫았다가 다시 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit na het overschakelen de app volledig en open deze opnieuw, zodat de hele interface de nieuwe taal gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przełączeniu całkowicie zamknij i otwórz aplikację ponownie, aby cały interfejs używał nowego języka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a troca, feche totalmente e reabra o aplicativo para que toda a interface use o novo idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После переключения полностью закройте и снова откройте приложение, чтобы весь интерфейс использовал новый язык."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากเปลี่ยนแล้ว ให้ปิดแอปโดยสมบูรณ์แล้วเปิดใหม่เพื่อให้อินเทอร์เฟซทั้งหมดใช้ภาษาใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş yaptıktan sonra, tüm arayüzün yeni dili kullanması için uygulamayı tamamen kapatıp yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після перемикання повністю закрийте та знову відкрийте програму, щоб весь інтерфейс використовував нову мову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi chuyển đổi, hãy đóng hoàn toàn và mở lại ứng dụng để toàn bộ giao diện sử dụng ngôn ngữ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换后请完全关闭并重新打开 App，界面才会全部换成新语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換後請完全關閉並重新開啟 App，介面才會全部換成新語言。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "切換後請完全關閉並重新開啟 App，介面才會全部換成新語言。"
          }
        },
        "zh-Hant-MO": {
          "stringUnit": {
            "state": "translated",
            "value": "切換後請完全關閉並重新開啟 App，介面才會全部換成新語言。"
