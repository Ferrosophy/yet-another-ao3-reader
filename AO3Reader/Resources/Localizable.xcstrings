    "此作品僅限登入用戶閱讀": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العمل متاح فقط للمستخدمين الذين قاموا بتسجيل الدخول"
          }
        },
        "de": {
          "stringUnit": {
